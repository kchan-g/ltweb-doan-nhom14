# Tệp cấu hình bảo mật môi trường
.env
.env.*
!.env.example

/vendor/

# Logs phát sinh khi chạy
/logs/*
!/logs/.htaccess
!/logs/.gitkeep

# Storage: Dữ liệu phát sinh runtime
/storage/*
!/storage/.htaccess
!/storage/.gitkeep
/storage/avatars/*
!/storage/avatars/.gitkeep
*.jsonl
*.log

# Uploads của người dùng
/uploads/*
!/uploads/.htaccess
!/uploads/.gitkeep

# OS & Editor temp files
.DS_Store
Thumbs.db
.vscode/
.idea/
.agent/
.agents/
AGENTS.md
